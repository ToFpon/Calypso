#!/usr/bin/make -f
# Application en Python sans module installé dans site-packages : le code va dans
# /usr/share/calypso-pdf (privé), dh_python3 le compile à l'installation (py3compile).
# Paquet « calypso-pdf » : Ubuntu et Debian ont déjà un paquet « calypso » (serveur CalDAV, /usr/bin/calypso).

%:
	dh $@ --with python3

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/calypso-pdf/usr/share/calypso-pdf
	cp -r calypso data debian/calypso-pdf/usr/share/calypso-pdf/
	find debian/calypso-pdf/usr/share/calypso-pdf -name __pycache__ -type d -prune -exec rm -rf {} +
	rm -f debian/calypso-pdf/usr/share/calypso-pdf/data/locale/*.pot

override_dh_python3:
	dh_python3 /usr/share/calypso-pdf
